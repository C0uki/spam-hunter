# このファイルを .env にコピーして使う。.env は Git に入れない。

# 任意。空なら Discord に通知しない（M3 から使う）
DISCORD_WEBHOOK_URL=

# 任意。空なら配信状況の自動取得と自動終了は無効（M3 から使う）
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# 任意。空なら data/pseudonym_salt に自動で作る。一度決めたら変えないこと（仮名 ID が変わるため）
PSEUDONYM_SALT=

# 任意。データの置き場所（既定: リポジトリ直下の data/）
DATA_DIR=

# ダッシュボード（M4 から使う）
HOST=127.0.0.1
PORT=8765
